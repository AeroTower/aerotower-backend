# Copie para .env e preencha. O .env nao vai para o git.
#
# A senha antiga ("Hidro123") esta no historico publico deste repositorio
# desde maio de 2026 — troque a credencial no painel do HiveMQ e use a nova
# aqui. No Render, os mesmos nomes entram em Environment, nao em arquivo.

MQTT_USER=
MQTT_PASS=

# Opcionais: so preencha para apontar para outro broker ou outro banco.
# MQTT_BROKER=47d5de0ce14d4654a95021e273720719.s1.eu.hivemq.cloud
# MQTT_PORT=8883
# DATABASE_URL=sqlite:///./plantas.db

# ── Várias torres ─────────────────────────
# MQTT_PREFIXO=aerotower        # topicos aerotower/<torre_id>/...
# TORRE_LEGADA=AT-LEGADO        # recebe hidroponia/* e as rotas antigas

# ── Login (feito pelo auth-aerotower) ─────
# MESMO valor do JWT_SEGREDO do servico de autenticacao.
JWT_SEGREDO=

# Chave do worker do auth-aerotower para PUT /internal/torres/{id}.
# MESMO valor do SERVICO_API_KEY de la.
SERVICO_API_KEY=
